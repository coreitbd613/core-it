// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AuthScope {
  CLIENT
  ADMIN
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  password        String?
  name            String?
  googleId        String?        @unique
  avatarUrl       String?
  contactNumber   String?
  whatsappNumber  String?
  jobTitle        String?
  role            Role           @default(USER)
  emailVerified   Boolean        @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  refreshTokens   RefreshToken[]
  authTokens      AuthToken[]
  domainOrders    DomainOrder[]
  memberships     Membership[]
  payments        Payment[]
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  BILLING
}

enum MembershipStatus {
  PENDING
  ACTIVE
}

model Organization {
  id   String @id @default(uuid())
  name String
  slug String @unique

  logoUrl     String?
  industry    String?
  description String?

  email   String?
  phone   String?
  website String?

  addressLine1  String?
  city          String?
  stateProvince String?
  country       String?

  tradeLicense String?
  tin          String?
  bin          String?

  whatsappBusiness String?
  facebookPage     String?
  instagramPage    String?
  linkedinPage     String?

  billingEmail   String?
  billingPhone   String?
  billingAddress String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships Membership[]
  invoices    Invoice[]
  projects    Project[]
}

model Membership {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role   MembershipRole   @default(MEMBER)
  status MembershipStatus @default(ACTIVE)

  invitedEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(uuid())
  hash      String
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

model RefreshToken {
  id        String    @id @default(uuid())
  hash      String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     AuthScope @default(CLIENT)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

enum DomainOrderStatus {
  PENDING
  COMPLETED
  REJECTED
}

model DomainOrder {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  domainName String
  tld        String
  years      Int    @default(1)

  priceUsd     Decimal
  priceBdt     Decimal
  exchangeRate Decimal

  status    DomainOrderStatus @default(PENDING)
  adminNote String?

  registrantFirstName     String
  registrantLastName      String
  registrantAddress1      String
  registrantAddress2      String?
  registrantCity          String
  registrantStateProvince String
  registrantCountry       String
  registrantPhone         String
  registrantEmail         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum DiscountType {
  PERCENT
  FLAT
}

enum PaymentMethod {
  BKASH
  NAGAD
  ROCKET
  BANK_TRANSFER
  CASH
  OTHER
}

model Invoice {
  id             String        @id @default(uuid())
  number         String        @unique
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Set instead of organizationId for one-off billing to a customer who
  // isn't a registered Organization. Exactly one of the two must be set —
  // enforced in the service, not the DB.
  customerName        String?
  // Optional company name for a one-off customer, shown alongside
  // customerName as the contact (e.g. company "Acme Corp", contact "Jane Doe").
  customerCompanyName String?

  proposalId String? // no real Proposal backend exists yet — freeform, not a FK

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  status     InvoiceStatus @default(DRAFT)
  voidReason String?

  taxPercent Float @default(0)

  // Exactly one applies, chosen by discountType — the other stays at its default.
  discountType    DiscountType @default(PERCENT)
  discountPercent Float        @default(0)
  discountFlatBdt Decimal      @default(0)

  notes String?

  issuedAt DateTime @default(now())
  dueAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@index([organizationId])
  @@index([status])
  @@index([projectId])
}

model InvoiceLineItem {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description  String
  quantity     String? // freeform label, e.g. "1 year", "2 licenses" — not used in Amount math
  unitPriceBdt Decimal // the line's Amount directly, no quantity multiplication

  @@index([invoiceId])
}

model Payment {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amountBdt     Decimal
  method        PaymentMethod
  note          String?
  transactionId String?

  recordedByUserId String?
  recordedByUser   User?   @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)

  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([recordedByUserId])
}

model InvoiceSequence {
  year       Int @id
  lastNumber Int @default(0)
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum RevisionStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum TeamAccessLevel {
  FULL
  EDIT
  VIEW
}

enum SupportSla {
  STANDARD
  PRIORITY
  PREMIUM
}

enum DeploymentMethod {
  MANUAL
  CI_CD
  FTP
  GIT_PUSH
}

model Project {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?

  proposalId String? // no real Proposal backend exists yet — freeform, not a FK
  contractId String? // no real Contract backend exists yet — freeform, not a FK

  status            ProjectStatus @default(PLANNING)
  startedAt         DateTime
  targetEndAt       DateTime?
  completedAt       DateTime?
  includedRevisions Int           @default(0)
  supportMonths     Int           @default(0)

  // Basic info
  projectType        String?
  department         String?
  projectManagerName String?

  // Commercial
  paymentTerms     String?
  paymentSchedule  String?
  contractValueBdt Decimal?

  // Timeline
  goLiveAt DateTime?

  // Revision policy
  revisionWindowDays    Int?
  maxDaysPerRevision    Int?
  extraRevisionPriceBdt Decimal?
  revisionNotes         String?

  // After-sales support
  supportSla             SupportSla @default(STANDARD)
  supportWorkingHours    String?
  includedSupportTickets Int?
  supportContactName     String?
  sendRenewalReminder    Boolean    @default(false)

  // Technical / credentials
  domain           String?
  hostingProvider  String?
  serverDetails    String?
  repositoryUrl    String?
  stagingUrl       String?
  productionUrl    String?
  techStack        String?
  deploymentMethod DeploymentMethod?
  credentialsNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones       ProjectMilestone[]
  revisionRequests ProjectRevisionRequest[]
  credentials      ProjectCredential[]
  teamMembers      ProjectTeamMember[]
  invoices         Invoice[]

  @@index([organizationId])
  @@index([status])
}

model ProjectMilestone {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  dueAt       DateTime?
  status      MilestoneStatus @default(PENDING)
  completedAt DateTime?

  @@index([projectId])
}

model ProjectRevisionRequest {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  description String
  status      RevisionStatus @default(OPEN)
  requestedBy String
  requestedAt DateTime       @default(now())
  respondedAt DateTime?

  @@index([projectId])
}

model ProjectCredential {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  label    String
  username String?
  password String?
  url      String?
  notes    String?

  @@index([projectId])
}

model ProjectTeamMember {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  role        String
  accessLevel TeamAccessLevel @default(VIEW)

  @@index([projectId])
}
